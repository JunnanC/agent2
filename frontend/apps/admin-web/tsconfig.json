{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@edu/ui": ["./src/legacy/ui.tsx"],
      "@edu/api-client": ["./src/legacy/api-client.ts"],
      "@edu/auth-client": ["../../packages/auth-client/src/index.ts"],
      "@edu/event-client": ["./src/legacy/event-client.ts"],
