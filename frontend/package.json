{
  "name": "edu-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:admin": "npm run dev -w @edu/admin-web",
    "dev:student": "npm run dev -w @edu/student-web",
    "dev:user": "npm run dev:student",
    "dev:teacher": "npm run dev -w @edu/teacher-web",
    "build": "npm run build --workspaces",
    "build:admin": "npm run build -w @edu/admin-web",
    "build:student": "npm run build -w @edu/student-web",
    "build:user": "npm run build:student",
    "build:teacher": "npm run build -w @edu/teacher-web",
    "typecheck": "npm run typecheck --workspaces",
    "test": "node --test apps/admin-web/src/data.test.ts"
  },
  "dependencies": { "react": "18.3.1", "react-dom": "18.3.1" },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.0.3",
    "typescript": "5.9.2",
    "vite": "^7.3.6"
  }
}
