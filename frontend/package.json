{
  "name": "edu-agent-frontend",
  "private": true,
  "type": "module",
  "version": "0.16.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:student": "npm --workspace @edu/student-web run dev",
    "dev:teacher": "npm --workspace @edu/teacher-web run dev",
    "dev:admin": "npm --workspace @edu/admin-web run dev",
    "build:student": "npm --workspace @edu/student-web run build",
    "build:teacher": "npm --workspace @edu/teacher-web run build",
    "build:admin": "npm --workspace @edu/admin-web run build",
    "build": "npm run build:student && npm run build:teacher && npm run build:admin",
    "typecheck": "npm run typecheck:packages && npx tsc -p apps/student-web --noEmit && npx tsc -p apps/teacher-web --noEmit && npx tsc -p apps/admin-web --noEmit",
    "typecheck:packages": "tsc -p packages/ui --noEmit && tsc -p packages/auth-client --noEmit && tsc -p packages/query-keys --noEmit && tsc -p packages/event-client --noEmit && tsc -p packages/api-client --noEmit",
    "generate:api": "openapi-typescript openapi.json -o packages/api-client/src/generated/schema.d.ts",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.5.2",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.0.3",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.21",
    "globals": "16.4.0",
    "jsdom": "27.0.0",
    "openapi-typescript": "7.9.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "dompurify": "^3.4.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  }
}
