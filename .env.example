# Release identity
COMPOSE_FILE=docker-compose.dev.yml
APP_ENV=local
APP_VERSION=0.15.0-p15
OPENAPI_REVISION=v2-p15
SIMILARITY_ALGORITHM_VERSION=char-5gram-jaccard-v1
SIMILARITY_THRESHOLD=0.30
SIMILARITY_RETENTION_DAYS=180
AUTO_CHECK_MAX_ATTEMPTS=3
CELERY_CONCURRENCY=4
GIT_REVISION=development
BUILD_TIME=development

# Container build bases (override with the official image names when Docker Hub is reachable)
PYTHON_BASE_IMAGE=public.ecr.aws/docker/library/python:3.14-slim
NODE_BASE_IMAGE=public.ecr.aws/docker/library/node:24-alpine
NGINX_BASE_IMAGE=public.ecr.aws/docker/library/nginx:1.29-alpine
DEBIAN_MIRROR=https://mirrors.aliyun.com/debian
DEBIAN_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security

# Django
DJANGO_SETTINGS_MODULE=education_experiment_platform.settings.local
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
IDENTITY_HMAC_KEY=replace-with-an-independent-random-hmac-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django,student.localhost,teacher.localhost,admin.localhost,api.localhost
DJANGO_TRUSTED_ORIGINS=http://student.localhost:8080,http://teacher.localhost:8080,http://admin.localhost:8080
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.edu
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.edu
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@example.edu
STUDENT_PUBLIC_URL=http://student.localhost:8080
TEACHER_PUBLIC_URL=http://teacher.localhost:8080
TRUSTED_PROXY_CIDRS=127.0.0.0/8,172.29.20.0/24
APP_NETWORK_SUBNET=172.29.20.0/24
ENTRY_PORT=8080
FLUENTD_HOST_PORT=24224
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090

# MySQL
MYSQL_IMAGE=public.ecr.aws/docker/library/mysql:8.4
MYSQL_DATABASE=edu_platform
MYSQL_MIGRATION_USER=edu_platform_migration
MYSQL_MIGRATION_PASSWORD=replace-migration-password
MYSQL_APP_USER=edu_platform_app
MYSQL_APP_PASSWORD=replace-app-password
MYSQL_ROOT_PASSWORD=replace-root-password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Redis / Celery
REDIS_URL=redis://redis:6379/0
OUTBOX_REDIS_STREAM=edu:events:v2
OUTBOX_REDIS_MAXLEN=10000
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
PUBLICATION_SYNC_LIMIT=100
PUBLICATION_CHUNK_SIZE=50

# MongoDB runtime logs only
MONGO_INITDB_ROOT_USERNAME=runtime_logger
MONGO_INITDB_ROOT_PASSWORD=replace-mongo-password
MONGO_REPLICA_SET_KEY=replace-with-a-random-string-longer-than-32-characters
MONGODB_URI=mongodb://runtime_logger:replace-mongo-password@mongodb:27017/observability?authSource=admin&replicaSet=rs0
MONGODB_LOG_DATABASE=observability
MONGODB_LOG_COLLECTION=runtime_logs
MONGODB_LOG_TTL_DAYS=30

# MinIO / ClamAV
MINIO_ROOT_USER=edu-platform
MINIO_ROOT_PASSWORD=replace-minio-password
MINIO_ENDPOINT=http://minio:9000
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=edu-platform
MINIO_APP_ACCESS_KEY=edu-platform-app
MINIO_APP_SECRET_KEY=replace-minio-app-password
AGENT_SOURCE_MAX_BYTES=2097152
AGENT_SOURCE_UPLOAD_EXPIRES_SECONDS=300
MINIO_REGION=us-east-1
MINIO_API_PORT=9000
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
WORKSPACE_SNAPSHOT_MAX_BYTES=20971520
SSE_HEARTBEAT_SECONDS=20
TEMPLATE_ASSET_MAX_BYTES=20971520
TEMPLATE_UPLOAD_EXPIRES_SECONDS=900
TEMPLATE_CHECK_TIMEOUT_MAX_SECONDS=300
REPORT_ATTACHMENT_MAX_BYTES=20971520
REPORT_UPLOAD_EXPIRES_SECONDS=900
FILE_DOWNLOAD_GRANT_TTL_SECONDS=300
ARCHIVE_RETENTION_DAYS=365
ARCHIVE_SAFE_RECYCLE_SECONDS=900
ARCHIVE_EXPORT_TTL_SECONDS=300
ARCHIVE_MAX_ATTEMPTS=5
RUNTIME_EXECUTION_RETENTION_DAYS=30
RUNTIME_CLEANUP_MAX_ATTEMPTS=10

# Experiment runtime (Docker Socket is local-only; production uses mTLS)
RUNTIME_MODE=local
RUNTIME_ADAPTER_CODE=runtime/local-docker
RUNTIME_ADAPTER_CONFIGS={"runtime/local-docker":{"pids_limit":256},"runtime/swarm":{"request_timeout":30}}
LOCAL_RUNTIME_IMAGE=experimental-platform-stdio:local
# Compose derives this from the selected project; override only for an external network.
# LOCAL_RUNTIME_NETWORK=experimental-platform-runtime
LOCAL_DOCKER_HOST=unix:///var/run/docker.sock
LOCAL_RUNTIME_MODE=REAL
# Docker Desktop uses GID 0; on Linux set this to: stat -c %g /var/run/docker.sock
DOCKER_SOCKET_GID=0
SWARM_DOCKER_HOST=unix:///var/run/docker.sock
SWARM_DOCKER_API_VERSION=auto
SWARM_DOCKER_TLS_VERIFY=false
SWARM_DOCKER_CA_PATH=/run/secrets/swarm_docker_ca
SWARM_DOCKER_CERT_PATH=/run/secrets/swarm_docker_cert
SWARM_DOCKER_KEY_PATH=/run/secrets/swarm_docker_key
SWARM_REQUEST_TIMEOUT_SECONDS=30
SWARM_BOOT_TIMEOUT_SECONDS=120
SWARM_POLL_INTERVAL_SECONDS=2
SWARM_RUNTIME_NETWORK=experimental-platform-swarm-runtime
RUNTIME_DEFAULT_TTL_SECONDS=14400

# Optional rubric AI (OpenAI-compatible API for report scoring suggestions)
# Set all three provider values in .env to enable; use the provider's base URL and model name.
RUBRIC_AI_API_KEY=
RUBRIC_AI_BASE_URL=
RUBRIC_AI_MODEL_NAME=
RUBRIC_AI_TIMEOUT_SECONDS=60

# Gateway
KONG_LOG_LEVEL=notice

# Observability
OTEL_SERVICE_NAME=edu-platform-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus
LOG_LEVEL=INFO
AUDIT_IP_HASH_SALT=replace-with-a-random-audit-hash-salt

# Accounts and portal sessions
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_ATTEMPTS=8
USER_SESSION_IDLE_SECONDS=43200
TEACHING_SESSION_IDLE_SECONDS=28800
PLATFORM_SESSION_IDLE_SECONDS=3600
USER_SESSION_ABSOLUTE_SECONDS=604800
TEACHING_SESSION_ABSOLUTE_SECONDS=86400
PLATFORM_SESSION_ABSOLUTE_SECONDS=28800
COURSE_INVITATION_HMAC_KEY=replace-with-a-dedicated-course-invitation-secret

# Optional chapter drafting provider; when omitted, reuse RUBRIC_AI_*.
# CHAPTER_AI_API_KEY=
# CHAPTER_AI_BASE_URL=
# CHAPTER_AI_MODEL_NAME=
