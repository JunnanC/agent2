{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": ["arn:aws:s3:::p02-platform"]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::p02-platform/template-assets/*",
        "arn:aws:s3:::p02-platform/course-materials/*",
        "arn:aws:s3:::p02-platform/workspaces/*",
        "arn:aws:s3:::p02-platform/assessment/*",
        "arn:aws:s3:::p02-platform/assessment-tests/*",
        "arn:aws:s3:::p02-platform/reports/*",
        "arn:aws:s3:::p02-platform/archives/*"
      ]
    }
  ]
}
