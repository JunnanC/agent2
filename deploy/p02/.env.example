# Run python3 deploy/p02/p02.py init; never commit the generated .env.
RELEASE_TAG=p02-06fa92e-v1
# Provisional until read-only server preflight confirms architecture.
TARGET_PLATFORM=linux/amd64
LOCAL_DOCKER_CONTEXT=desktop-linux
P02_PROXY_CIDRS=127.0.0.1/32
P02_RUNTIME_APPROVED=false
DOCKER_SOCKET_GID=
P02_GROUP_MEMORY_MB=
P02_GROUP_CPU_MILLICORES=
DJANGO_SECRET_KEY=
IDENTITY_HMAC_KEY=
AUDIT_IP_HASH_SALT=
COURSE_INVITATION_HMAC_KEY=
MYSQL_ROOT_PASSWORD=
MYSQL_MIGRATION_PASSWORD=
MYSQL_APP_PASSWORD=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_REPLICA_SET_KEY=
MINIO_ROOT_PASSWORD=
MINIO_APP_SECRET_KEY=
# Base references must be pinned by digest in release-lock.json before transfer/deploy.
MONGO_IMAGE=mongo:8.0
REDIS_IMAGE=redis:7.4-alpine
MINIO_IMAGE=bitnamilegacy/minio:latest
CLAMAV_IMAGE=clamav/clamav:1.4
NGINX_IMAGE=nginx:1.29-alpine
P02_RUNTIME_CPU_MILLICORES=
P02_RUNTIME_MEMORY_MB=
P02_CLAMAV_DATABASE_READY=false
